{
  "info": {
    "_postman_id": "b9is121-cloudops-api",
    "name": "B9IS121 CloudOps API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://REPLACE_WITH_CLOUD_RUN_URL"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/healthz"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('status ok',()=>pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Service info",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/info"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('build SHA present',()=>pm.expect(pm.response.json().build_sha).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "List resources",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/resources"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('five resources',()=>pm.expect(pm.response.json().count).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "Find GitHub resource",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/resources/github"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing resource - expected 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/resources/missing"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Valid echo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/echo",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"deployment validation\",\n  \"correlation_id\": \"postman-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('echo correct',()=>pm.expect(pm.response.json().message).to.eql('deployment validation'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid echo - expected 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/echo",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422',()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    }
  ]
}